{
  "name": "worklog-platform",
  "version": "1.0.0",
  "description": "WorkLog (FIND IT, PROVE IT) - Worker-First Digital Employment Platform for India's Informal Workforce",
  "scripts": {
    "dev:backend": "npm run start --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "seed": "node backend/prisma/seed.js",
    "prisma:push": "npx --prefix backend prisma db push",
    "prisma:generate": "npx --prefix backend prisma generate",
    "build:frontend": "npm run build --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend"
  },
  "keywords": [
    "worklog",
    "informal-workforce",
    "attendance-verification",
    "wage-ledger",
    "trust-score",
    "smart-dispute-assistant",
    "react",
    "nodejs",
    "postgresql",
    "prisma"
  ],
  "author": "Google Antigravity Team",
  "license": "MIT"
}
